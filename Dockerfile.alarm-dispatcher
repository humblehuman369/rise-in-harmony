# Rise In Harmony alarm-dispatcher worker image.
#
# Railway service `rih-alarm-dispatcher`: set RAILWAY_DOCKERFILE_PATH to this
# file and leave the start command blank — CMD below starts the worker.
#
# This image is intentionally minimal compared to the API Dockerfile: no ffmpeg
# or rubberband (those are TrueHz Convert's DSP dependencies, not the worker's),
# no Vite build, and no EXPOSE. The dispatcher is private and takes no inbound
# traffic.
FROM node:22-bookworm-slim AS build

WORKDIR /app
RUN npm install -g corepack@latest

# Manifests first so the dependency layer caches across source-only changes.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY packages ./packages
COPY apps/mobile/package.json ./apps/mobile/package.json
RUN corepack pnpm install --frozen-lockfile

COPY . .
ENV NODE_ENV=production
RUN corepack pnpm build:alarm-dispatcher

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist/alarm-dispatcher.js ./dist/alarm-dispatcher.js

# Run unprivileged; the node image ships a `node` user.
USER node

# No EXPOSE and no public domain: the worker reaches MySQL over Railway's
# private network and only makes outbound calls to push providers.
#
# Started directly rather than through pnpm so SIGTERM reaches Node as PID 1 and
# the graceful-shutdown path (release lease, close pool) actually runs.
CMD ["node", "dist/alarm-dispatcher.js"]
