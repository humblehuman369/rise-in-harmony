# Rise In Harmony — environment template
# Copy to .env and fill in values. Never commit real secrets.

NODE_ENV=development
PORT=3000

# Required in production (≥32 characters)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# MySQL connection string
DATABASE_URL=mysql://user:password@host:3306/rise_in_harmony

# Optional pool size (default 10)
# DB_POOL_SIZE=10

# Manus / OAuth
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Bootstrap admins (comma-separated emails, promoted on sign-in)
RIH_ADMIN_EMAILS=you@example.com

# Storage (Manus Forge)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@riseinharmony.app
APP_URL=https://www.riseinharmony.com

# Stripe web billing (RIH_ prefix — do not use platform STRIPE_* vars)
RIH_STRIPE_SECRET_KEY=
RIH_STRIPE_WEBHOOK_SECRET=

# RevenueCat mobile billing
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=

# Optional: authorize POST /api/scheduled/* without Manus cron identity
CRON_SECRET=

# Web Push (VAPID) — required for alarm push notifications to sleeping devices
# Generate with: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k);"
RIH_VAPID_PUBLIC_KEY=
RIH_VAPID_PRIVATE_KEY=
RIH_VAPID_EMAIL=mailto:hello@riseinharmony.com

# ─── Alarm dispatcher worker (rih-alarm-dispatcher service only) ──────────────
# The API does not need these. The dispatcher gets DB + VAPID + these, and must
# NOT receive Stripe, Resend, RevenueCat or storage credentials.
#
# Use a SEPARATE VAPID keypair per environment — a staging device must never be
# able to receive production alarm pushes.
#
# Start with shadow mode ON: it logs the occurrences it would deliver and writes
# nothing, so turning it off later cannot replay a backlog.
ALARM_SHADOW_MODE=true
# Fallback IANA zone for alarms created before alarms.timezone existed.
ALARM_DEFAULT_TIMEZONE=America/New_York
# Loop period; 30s or 60s. Leader lease MUST exceed it.
ALARM_DISPATCH_INTERVAL_MS=30000
ALARM_DISPATCH_LEADER_LEASE_MS=90000
# Must be >= the leader lease.
ALARM_DISPATCH_TARGET_LEASE_MS=90000
# How far back a tick reconciles missed occurrences.
ALARM_DISPATCH_GRACE_MS=600000
ALARM_DISPATCH_BATCH_SIZE=100
ALARM_DISPATCH_CONCURRENCY=8
ALARM_MAX_ATTEMPTS=3
# Optional stable worker identity; auto-generated per process when unset.
# ALARM_DISPATCH_INSTANCE_ID=

# Git SHA for tracing a deploy across Railway/Vercel logs and heartbeats.
RELEASE_SHA=

# Analytics (client)
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# TrueHz Convert (optional)
# RIH_CONVERT_ENABLED=true
# CONVERT_WORKER_CONCURRENCY=1
# CONVERT_STALE_MINUTES=30
# Host must have ffmpeg, ffprobe, and rubberband on PATH for DSP jobs
